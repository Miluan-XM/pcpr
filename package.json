{
  "name": "pcpr",
  "displayName": "Programmer Chat Programming Robot",
  "description": "A Programmer Chat Programming Robot, detecting logical errors in your code.",
  "version": "0.0.8",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Linters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lin3939/pcpr.git"
  },
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished",
    "onOpenFile"
  ],
  "main": "./extension.mjs",
  "icon": "./logo.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pcpr",
          "title": "PCPR",
          "icon": "sidebar_logo.svg",
          "when": "workbenchState != empty"
        }
      ]
    },
    "views": {
      "pcpr": [
        {
          "type": "webview",
          "id": "pcpr.webviewChat",
          "name": "PCPR Chat",
          "icon": "sidebar_logo.svg",
          "when": "workbenchState != empty"
        }
      ]
    },
    "commands": [
      {
        "command": "pcpr.checkCode",
        "title": "PCPR Check Code"
      },
      {
        "command": "pcpr.webviewChat",
        "title": "PCPR Web Chat",
        "when": "workbenchState != empty"
      },
      {
        "command": "pcpr.addApi",
        "title": "PCPR: Add API"
      },
      {
        "command": "pcpr.switchApi",
        "title": "PCPR: Switch API"
      },
      {
        "command": "pcpr.manageApis",
        "title": "PCPR: Manage APIs"
      },
      {
        "command": "pcpr.editApi",
        "title": "PCPR: Edit API"
      },
      {
        "command": "pcpr.deleteApi",
        "title": "PCPR: Delete API"
      },
      {
        "command": "pcpr.toggleInlineCompletion",
        "title": "PCPR: Toggle Inline Completion"
      },
      {
        "command": "pcpr.triggerInlineCompletion",
        "title": "PCPR: Trigger Inline Completion Now"
      },
      {
        "command": "pcpr.inlineCompletionStatus",
        "title": "PCPR: Inline Completion Troubleshooting"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pcpr.webviewChat",
          "title": "PCPR Web Chat",
          "when": "editorLangId != code-text-binary"
        },
        {
          "command": "pcpr.manageApis",
          "title": "PCPR Manage APIs"
        },
        {
          "command": "pcpr.triggerInlineCompletion",
          "title": "PCPR: Trigger Inline Completion Now",
          "when": "editorTextFocus"
        },
        {
          "command": "pcpr.toggleInlineCompletion",
          "title": "PCPR: Inline Completion On (click to disable)",
          "when": "editorTextFocus && config.pcpr.inlineCompletion.enabled"
        },
        {
          "command": "pcpr.toggleInlineCompletion",
          "title": "PCPR: Inline Completion Off (click to enable)",
          "when": "editorTextFocus && !config.pcpr.inlineCompletion.enabled"
        }
      ]
    },
    "configuration": {
      "title": "PCPR Inline Completion",
      "properties": {
        "pcpr.inlineCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable AI powered inline (ghost text) code completion."
        },
        "pcpr.inlineCompletion.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "markdownDescription": "Delay in milliseconds before an automatic completion is requested while typing. Higher values reduce the number of API calls."
        },
        "pcpr.inlineCompletion.maxPrefixCharacters": {
          "type": "number",
          "default": 6000,
          "minimum": 200,
          "maximum": 40000,
          "markdownDescription": "Maximum number of characters of the code **before** the cursor that is sent as context."
        },
        "pcpr.inlineCompletion.maxSuffixCharacters": {
          "type": "number",
          "default": 2000,
          "minimum": 0,
          "maximum": 40000,
          "markdownDescription": "Maximum number of characters of the code **after** the cursor that is sent as context."
        },
        "pcpr.inlineCompletion.maxCompletionLines": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 200,
          "markdownDescription": "Maximum number of lines a single inline completion may insert."
        },
        "pcpr.inlineCompletion.maxTokens": {
          "type": "number",
          "default": 1024,
          "minimum": 16,
          "maximum": 20480,
          "markdownDescription": "Maximum number of tokens requested from the model for one inline completion. Reasoning models need a much larger budget than plain ones, otherwise they can spend all of it on hidden reasoning and return nothing."
        },
        "pcpr.inlineCompletion.includeProjectStructure": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Send the workspace structure as additional context for inline completions."
        },
        "pcpr.inlineCompletion.disabledLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "plaintext",
            "log",
            "ignore",
            "code-text-binary",
            "scminput",
            "git-commit",
            "git-rebase",
            "diff",
            "output",
            "search-result"
          ],
          "markdownDescription": "Language ids (as reported by VS Code, e.g. `python`, `markdown`) that never receive inline completions."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "openai": "^6.16.0"
  }
}
